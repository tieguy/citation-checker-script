# Template for local secrets used by `act` when running tier 3 / tier 4
# workflows. Copy to `.secrets` and fill in real values:
#
#   cp .secrets.example .secrets
#   $EDITOR .secrets
#
# `.secrets` is in .gitignore — it must never be committed.
#
# Then run e.g.:
#   act -j llm-providers-sample --secret-file .secrets
#
# `act` reads .secrets automatically when present in the working directory,
# so passing --secret-file is only needed when the file is named differently.

# Required for tier 3 (llm-providers-sample) and tier 4 (accuracy-regression).
# Get from https://publicai.co/ (free, no credit card).
PUBLICAI_API_KEY=

# Optional — only needed if you want to test those provider integrations locally.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
